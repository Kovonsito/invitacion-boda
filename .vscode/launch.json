{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Chrome: Servidor Web (Puerto 5500)",
            "type": "chrome",
            "request": "launch",
            "url": "http://127.0.0.1:5500/index.html",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "Iniciar Servidor Web"
        },
        {
            "name": "Chrome: Probar Invitado Padrino (?id=11)",
            "type": "chrome",
            "request": "launch",
            "url": "http://127.0.0.1:5500/index.html?id=11",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "Iniciar Servidor Web"
        },
        {
            "name": "Edge: Servidor Web (Puerto 5500)",
            "type": "msedge",
            "request": "launch",
            "url": "http://127.0.0.1:5500/index.html",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "Iniciar Servidor Web"
        },
        {
            "name": "Chrome: Archivo directo (Sin Servidor)",
            "type": "chrome",
            "request": "launch",
            "file": "${workspaceFolder}/index.html"
        }
    ]
}
