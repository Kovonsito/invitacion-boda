{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Iniciar Servidor Web",
            "type": "shell",
            "command": "node server.js",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^\\[SERVER_READY\\]",
                    "endsPattern": "^\\[SERVER_READY\\]"
                }
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "clear": true
            }
        }
    ]
}
